---
import { profile } from '../data/profile';
import { url } from '../lib/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-canvas" data-hero-canvas aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="eyebrow">{profile.role} · {profile.location}</p>
    <h1 id="hero-title">
      <span class="name">{profile.name}</span>
      <span class="title">Unity game developer building <em>multiplayer</em>, <em class="alt">physics</em> and <em class="lime">tools</em>.</span>
    </h1>
    <p class="tagline">{profile.tagline}</p>
    <div class="cta">
      <a class="btn btn-primary" href="#projects">See my work</a>
      <a class="btn btn-ghost" href={url('resume/')}>View resume</a>
    </div>
    <ul class="stats" aria-label="At a glance">
      <li><strong>{profile.yearsExperience}+</strong><span>years in game dev</span></li>
      <li><strong>4</strong><span>studios</span></li>
      <li><strong>Unity · C#</strong><span>Photon Fusion</span></li>
    </ul>
  </div>
</section>

<script>
  const host = document.querySelector<HTMLElement>('[data-hero-canvas]');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function hasWebGL() {
    try {
      const c = document.createElement('canvas');
      return Boolean(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  if (host && hasWebGL()) {
    const load = () =>
      import('../scripts/hero-scene')
        .then((m) => m.mount(host, { reduceMotion }))
        .catch((err) => console.warn('Hero scene unavailable:', err));
    if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1200 });
    else setTimeout(load, 150);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 860px);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(60% 70% at 78% 45%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(40% 50% at 92% 80%, color-mix(in srgb, var(--accent-2) 12%, transparent), transparent 70%),
      var(--bg);
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: -2;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero-canvas.is-ready {
    opacity: 1;
  }
  .hero-canvas :global(canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 70%, transparent) 38%, transparent 62%);
  }
  .hero-content {
    padding-block: 96px 72px;
  }
  h1 {
    margin: 0 0 1.2rem;
    max-width: 15ch;
  }
  .name {
    display: block;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    letter-spacing: -0.03em;
  }
  .title {
    display: block;
    margin-top: 0.5rem;
    font-size: clamp(1.25rem, 2.6vw, 1.7rem);
    font-weight: 500;
    color: var(--text-muted);
    max-width: 24ch;
  }
  em {
    font-style: normal;
    color: var(--accent);
  }
  em.alt {
    color: var(--accent-2);
  }
  em.lime {
    color: var(--accent-3);
  }
  .tagline {
    max-width: 46ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 1.8rem 0 2.4rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .stats li {
    display: flex;
    flex-direction: column;
  }
  .stats strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
  }
  .stats span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 760px) {
    .hero {
      align-items: flex-start;
    }
    .hero-scrim {
      background: linear-gradient(180deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 82%, transparent) 55%, color-mix(in srgb, var(--bg) 40%, transparent) 100%);
    }
    .hero-content {
      padding-block: 56px 48px;
    }
  }
</style>
