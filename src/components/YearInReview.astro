---
import { timeline, year } from '../data/timeline';
import { getProjects, url } from '../lib/site';

const published = new Set((await getProjects()).map((p) => p.id));
const entries = timeline.filter((e) => e.show);
const kindLabel = { work: 'Work', project: 'Project', learning: 'Learning' } as const;
---

<section class="section year" id="year" aria-labelledby="year-title">
  <div class="container">
    <p class="eyebrow">{year} in review</p>
    <h2 class="section-title" id="year-title">What I built this year</h2>
    <p class="section-lede">Month by month, pulled together from my projects, commits and notes.</p>

    <ol class="track">
      {
        entries.map((e) => (
          <li class:list={['entry', e.kind]}>
            <span class="month">{e.month}</span>
            <div class="content">
              <span class="kind">{kindLabel[e.kind]}</span>
              <h3>
                {e.project && published.has(e.project) ? (
                  <a href={url(`projects/${e.project}/`)}>{e.title}</a>
                ) : (
                  e.title
                )}
              </h3>
              <p>{e.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .year {
    background: var(--bg-2);
  }
  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 16px;
    counter-reset: entry;
  }
  .entry {
    position: relative;
    padding: 18px 18px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    border-top: 3px solid var(--accent);
  }
  .entry.work {
    border-top-color: var(--accent-2);
  }
  .entry.learning {
    border-top-color: var(--accent-3);
  }
  .month {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
  }
  .kind {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-top: 2px;
  }
  h3 {
    font-size: 1.02rem;
    margin: 8px 0 4px;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: var(--accent);
  }
  p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
