---
import { Image } from 'astro:assets';
import { categoryLabel, url, type Project } from '../lib/site';

interface Props {
  project: Project;
  large?: boolean;
}
const { project, large = false } = Astro.props;
const { data } = project;
const href = url(`projects/${project.id}/`);
---

<article class:list={['card', { large }]} data-category={data.category}>
  <a class="media" href={href} tabindex="-1" aria-hidden="true">
    {
      data.cover ? (
        <Image
          src={data.cover}
          alt=""
          widths={large ? [480, 800, 1200] : [400, 640]}
          sizes={large ? '(max-width: 860px) 100vw, 560px' : '(max-width: 640px) 100vw, 360px'}
          loading="lazy"
        />
      ) : (
        <div class="placeholder">
          <span>{data.title}</span>
          {data.confidential && <em>Under NDA · engineering only</em>}
        </div>
      )
    }
  </a>
  <div class="body">
    <p class="meta">
      <span class:list={['tag', data.category]}>{categoryLabel[data.category]}</span>
      <span>{data.org}</span>
      <span>{data.period}</span>
    </p>
    <h3><a href={href}>{data.title}</a></h3>
    <p class="summary">{data.summary}</p>
    <ul class="chip-list">
      {data.stack.slice(0, large ? 6 : 4).map((s) => <li class="chip">{s}</li>)}
    </ul>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 60%, var(--border));
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.25);
  }
  .card[hidden] {
    display: none;
  }
  .media {
    display: block;
    text-decoration: none;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    overflow: hidden;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .media :global(img) {
    transform: scale(1.04);
  }
  .placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    background:
      linear-gradient(var(--border) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(90deg, var(--border) 1px, transparent 1px) 0 0 / 28px 28px,
      radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--accent) 20%, transparent), transparent 60%),
      var(--surface-2);
  }
  .placeholder {
    padding: 16px;
    text-align: center;
  }
  .placeholder span {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent);
    text-shadow: var(--glow);
  }
  .placeholder em {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface);
  }
  .body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin: 0;
  }
  .tag {
    color: var(--accent);
  }
  .tag.personal {
    color: var(--accent-3);
  }
  .tag.learning {
    color: var(--accent-2);
  }
  h3 {
    font-size: 1.2rem;
    margin: 0;
  }
  .large h3 {
    font-size: 1.5rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a::after {
    content: ' →';
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .card:hover h3 a::after {
    opacity: 1;
  }
  .summary {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0 0 6px;
    flex: 1;
  }
</style>
